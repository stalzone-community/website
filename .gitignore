# Upstream item database, re-fetched by `npm run db:vendor`. ~220 MB of
# JSON + PNG that EXBO regenerates on every game patch — never committed.
/vendor/

# Generated by `npm run db:build`, rebuilt inside the Docker image on deploy.
# items.json is ~6.8 MB and regenerates every patch — committing it would add
# roughly 78 MB/yr of churn. db-source.json and manifest.json ARE committed:
# they are the small record of what was last built, and what the next build
# diffs against to spot a content patch.
src/lib/data/items.json
src/lib/data/search-index.json

# 2 304 item icons (~35 MB), copied out of the vendor tree by db:build.
# Apache-2.0 so redistributing them is fine — they just have no business in
# git history when the build reproduces them exactly.
static/icons/
src/lib/data/recipes.json

# The build calculator's per-language payloads, generated by `npm run db:calc`
# from items.json. Same reasoning as above: derived, ~8 MB across five
# languages, and reproduced exactly by the build.
static/calc/
