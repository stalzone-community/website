# Copy to .env and fill in. Everything here is read through process.env, so the
# same values work in `vite dev` and in the plain-node scripts under scripts/.

MONGODB_URI=
MONGODB_DB=stalzone

# Web push (VAPID).
#
# Generate a pair with `npm run push:keys`. The public key is handed to browsers
# by /api/push/key and ends up inside every subscription; the private key signs
# each push and must never reach the client — in production it is a Fly secret,
# never a build arg.
#
# Regenerating the pair invalidates every existing subscription, silently and
# irreversibly, so treat a deployed pair as permanent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can reach you at if a push misbehaves.
# Must be a mailto: or https: URL; they will reject anything else.
VAPID_SUBJECT=mailto:you@example.com

# Absolute origin, used to build the click-through link inside a notification.
# A notification opens a window, so a relative path has nothing to resolve
# against. http://localhost:6791 for dev.
PUBLIC_ORIGIN=https://stalzone.cedricdessalles.dev

# EXBO API — https://eapi.stalcraft.net/
#
# Unset, the client talks to the DEMO host (dapi.stalzone.com) with EXBO's own
# published demo credentials, so a fresh checkout renders the auction pages with
# no setup. The demo host returns a fixture — the same ten sales for every item
# in the game — so the plumbing is real and the numbers are not.
#
# Setting the base to production is the ONE switch: exbo.ts derives tier() from
# the host, so the chart cannot end up labelling fixture data as a live market.
# Production is set in fly.toml, not here; uncomment locally to develop against
# real prices, at the cost of spending the rate limit from your machine.
# EXBO_API_BASE=https://eapi.stalzone.com

# Only used when EXBO_API_BASE points at production — the demo host is always
# called with the demo pair, whatever is set here. These are also the "Sign in
# with EXBO" application's credentials; the same application owns both.
EXBO_CLIENT_ID=
EXBO_CLIENT_SECRET=

# Region the auction prices are read from. EU when unset.
# EXBO_REGION=RU

# Signs the session cookie. Required for "Sign in with EXBO" alongside the two
# credentials above; without it authConfigured() is false and /auth/exbo
# redirects to /auth/unavailable. Must MATCH production or a cookie issued by
# one is rejected by the other, and changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Dev-only shortcut past OAuth entirely: any non-empty value becomes a signed-in
# user, so account pages and saved builds are workable without a round trip to
# exbo.net. Guarded by import.meta.env.DEV — a production build cannot be talked
# into a fake session by setting this.
# DEV_FAKE_USER=Geptyro
