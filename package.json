{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test \"tests/**/*.test.ts\"",
		"db:vendor": "node scripts/vendor-db.ts",
		"db:build": "node scripts/build-items.ts && node scripts/build-recipes.ts",
		"db:report": "node scripts/report-fields.ts",
		"db:seed": "node --env-file=.env scripts/seed-graph.ts",
		"db:seed:dry": "node scripts/seed-graph.ts --dry-run",
		"db": "npm run db:vendor && npm run db:build",
		"db:recipes": "node scripts/build-recipes.ts",
		"link:commons": "npm i ../../sveltekit-commons --no-save",
		"unlink:commons": "npm i"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"mongodb": "^7.5.0",
		"sveltekit-commons": "github:Geptyro/sveltekit-commons"
	}
}
