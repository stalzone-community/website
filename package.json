{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.service-worker.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test \"tests/**/*.test.ts\"",
		"push:keys": "node -e \"import('web-push').then((w) => console.log(w.default.generateVAPIDKeys()))\"",
		"push:send": "node --env-file=.env scripts/push-send.ts",
		"db:vendor": "node scripts/vendor-db.ts",
		"db:build": "node scripts/build-items.ts && node scripts/build-recipes.ts && node scripts/build-assembly.ts && node scripts/build-calc-index.ts",
		"db:calc": "node scripts/build-calc-index.ts",
		"db:assembly": "node scripts/build-assembly.ts",
		"db:assembly:check": "node scripts/build-assembly.ts --check",
		"db:models": "node scripts/build-models.ts",
		"db:models:check": "node scripts/build-models.ts --check",
		"db:report": "node scripts/report-fields.ts",
		"db:seed": "node --env-file=.env scripts/seed-graph.ts",
		"db:seed:dry": "node scripts/seed-graph.ts --dry-run",
		"feedback": "node --env-file=.env scripts/list-feedback.ts",
		"release": "node scripts/release.ts",
		"db": "npm run db:vendor && npm run db:build",
		"db:recipes": "node scripts/build-recipes.ts",
		"link:commons": "npm i ../../sveltekit-commons --no-save",
		"unlink:commons": "npm i"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.1",
		"@types/web-push": "^3.6.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@google/model-viewer": "^4.3.1",
		"cedricdessalles-commons": "git+https://github.com/Geptyro/cedricdessalles-commons.git#semver:^0.1.0",
		"grid-router": "^0.1.1",
		"mongodb": "^7.5.0",
		"sveltekit-commons": "git+https://github.com/Geptyro/sveltekit-commons.git#semver:^0.8.0",
		"web-push": "^3.6.7"
	}
}
